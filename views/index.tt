<section class="panel" id="queue">
    <h2>Up next <span class="count" id="queue_count">[% queued_total %]</span></h2>

    <!-- Only the next few are listed; data-limit keeps the JS that refreshes
         this list in step with what the server rendered. -->
    <ul class="songlist" id="queued_songs" data-limit="[% queue_limit %]">
    [% FOREACH song IN queued_songs %]
        <li>
        <div class="song">
            <span class="song-index">[% loop.count %]</span>
            <span class="song-meta">
                <span class="song-title">[% song.display_title | html %]</span>
                <span class="song-sub">[% song.artist | html %]</span>
            </span>
        </div>
        </li>
    [% END %]
    [% IF !queued_total %]
        <li class="empty">Nothing queued &ndash; be the first!</li>
    [% END %]
    </ul>

    <p class="queue-more hint"[% IF queued_total <= queue_limit %] hidden[% END %]>
        &hellip; and <span class="queue-more-count">[% queued_total - queue_limit %]</span> more waiting
    </p>

    <a class="btn btn-primary btn-block btn-big" href="/search">Queue a song</a>
</section>

<section class="panel" id="popular">
    <h2>Popular</h2>
    <p class="hint">The most-queued songs on this jukebox. Tap one to add it
    to the queue.</p>

    [% IF popular.size %]
        <form method="post" action="/enqueue">
        <ul class="songlist">
        [% FOREACH song IN popular %]
            <li>
            <button class="song" type="submit" name="song"
                    value="[% song.path | html %]"
                    data-queue="[% song.path | html %]"
                    data-label="[% song.display_title | html %]">
                <span class="song-index">[% loop.count %]</span>
                <span class="song-meta">
                    <span class="song-title">[% song.display_title | html %]</span>
                    <span class="song-sub">[% song.artist | html %]</span>
                </span>
                <span class="song-action" aria-hidden="true">+</span>
            </button>
            </li>
        [% END %]
        </ul>
        </form>

        <a class="btn btn-block" href="/popular">More popular songs</a>
    [% ELSE %]
        <p class="empty">
        Nothing&rsquo;s been queued yet, so there&rsquo;s no chart yet.
        <a href="/search">Pick the first song</a>.
        </p>
    [% END %]
</section>

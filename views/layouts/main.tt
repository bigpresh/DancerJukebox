<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- Without this, phones render the page at desktop width and you spend the
     evening pinch-zooming to hit things. -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0c0b10">
<!-- Lets iOS/Android "add to home screen" run it like an app, which is handy
     if you leave a tablet out for guests to use. -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>DancerJukebox</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="masthead">
    <span class="wordmark"><span class="dancer">Dancer</span>Jukebox</span>
    <span class="byline">by David Precious</span>
</header>

<!-- Now playing: sticky, so it stays reachable however far you've scrolled
     down a list of search results. -->
<div class="nowbar[% IF state == 'play' %] is-playing[% END %]">
    <span class="art" aria-hidden="true"></span>

    <div class="now-meta">
        <div class="now-label">Now playing</div>
        <div class="now-title">
            [% IF current %][% current.display_title | html %][% ELSE %]Nothing playing[% END %]
        </div>
        <div class="now-artist">[% current.artist | html %]</div>
    </div>

    <span class="now-time muted hint" aria-hidden="true"></span>

    <a class="btn btn-skip" href="/control/skip" data-skip
       title="Skip to the next song" aria-label="Skip to the next song">Skip</a>

    <div class="progress" aria-hidden="true"><div class="bar"></div></div>
</div>

<nav>
<ul class="nav">
    <li><a href="/"[% IF page == 'home' %] aria-current="page"[% END %]>Queue</a></li>
    <li><a href="/search"[% IF page == 'search' %] aria-current="page"[% END %]>Search</a></li>
    <li><a href="/popular"[% IF page == 'popular' %] aria-current="page"[% END %]>Popular</a></li>
</ul>
</nav>

<main class="wrap">

[% content %]

</main>

<footer class="footer">
    <p>
    <button type="button" class="power[% IF enabled %] is-on[% ELSE %] is-off[% END %]"
            aria-pressed="[% enabled ? 'true' : 'false' %]">
        <span class="dot" aria-hidden="true"></span>
        <span class="power-label">[% enabled ? 'Jukebox on' : 'Jukebox off' %]</span>
    </button>
    </p>
    <p>
    <a href="https://github.com/bigpresh/DancerJukebox">DancerJukebox</a>
    by <a href="https://blog.preshweb.co.uk/">David Precious</a>,
    powered by <a href="http://www.perldancer.org/">Dancer</a>
    </p>
</footer>

<!-- Toast messages land here; aria-live so they're announced, not just seen -->
<div class="toasts" role="status" aria-live="polite"></div>

<script src="/js/jukebox.js"></script>
</body>
</html>

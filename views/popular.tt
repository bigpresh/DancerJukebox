<section class="panel">
<h2>Most popular <span class="count">[% popular.size %]</span></h2>
<p class="hint">
The most-queued songs on this jukebox. Tap one to queue it again.
</p>

[% IF popular.size %]
    <form method="post" action="/enqueue">
    <ul class="songlist">
    [% FOREACH song IN popular %]
        <li>
        <button class="song" type="submit" name="song"
                value="[% song.path | html %]"
                data-queue="[% song.path | html %]"
                data-label="[% song.display_title | html %]">
            <span class="song-index">[% loop.count %]</span>
            <span class="song-meta">
                <span class="song-title">[% song.display_title | html %]</span>
                <span class="song-sub">
                    [%- IF song.artist %][% song.artist | html %] &middot; [% END -%]
                    played [% song.times_queued %] time[% song.times_queued == 1 ? '' : 's' %]
                </span>
            </span>
            <span class="song-action" aria-hidden="true">+</span>
        </button>
        </li>
    [% END %]
    </ul>
    </form>
[% ELSE %]
    <p class="empty">
    Nothing&rsquo;s been queued yet, so there&rsquo;s no chart to show.
    <a href="/search">Go and pick something</a> to get it started.
    </p>
[% END %]
</section>
